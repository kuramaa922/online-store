{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "jsx": "react-jsx",

        /* Код собирает Vite, TypeScript только проверяет типы */
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,

        /* Строгость — включена намеренно: так ошибки видны до запуска */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,

        /* Алиас. Должен совпадать с resolve.alias в vite.config.ts */
        "paths": {
            "@/*": ["./src/*"]
        },

        /* Типы Vite: import.meta.env, импорт картинок и CSS; SVG с ?react */
        "types": ["vite/client", "vite-plugin-svgr/client"]
    },
    "include": ["src", "vitest.setup.ts"]
}
