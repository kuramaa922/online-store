{
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "quoteProps": "as-needed",
    "htmlWhitespaceSensitivity": "css",
    "overrides": [
        {
            "files": ["*.md", "*.mdx"],
            "options": { "printWidth": 80, "proseWrap": "preserve" }
        },
        {
            "files": ["*.json", "*.jsonc", "*.yml", "*.yaml"],
            "options": { "singleQuote": false }
        }
    ]
}
